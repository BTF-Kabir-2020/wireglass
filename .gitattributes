# Normalize line endings; keep binary assets untouched.
* text=auto eol=lf

*.rs    text
*.toml  text
*.yml   text
*.yaml  text
*.json  text
*.md    text
*.sh    text eol=lf
Dockerfile text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary

# Generated; keep out of diffs and language stats.
Cargo.lock linguist-generated=true

# agent-browser capture artifacts (never shipped in archives)
.agent-screenshots/** binary
.agent-screenshots/** export-ignore
