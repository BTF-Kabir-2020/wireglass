# Normalize line endings; keep binary assets untouched.
* text=auto eol=lf

*.rs    text
*.toml  text
*.yml   text
*.yaml  text
*.json  text
*.md    text

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary

# Generated; keep out of diffs and language stats.
Cargo.lock linguist-generated=true
